{
  "name": "talindia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4343",
    "build": "next build",
    "start": "next start -p 4343",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 4343",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply talindia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply talindia-db --remote",
    "migrate:wp": "tsx scripts/migrate-wordpress.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "backup:d1": "tsx scripts/backup.ts d1",
    "backup:r2": "tsx scripts/backup.ts r2",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "images:static": "tsx scripts/optimize-static.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "marked": "^18.1.2",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
