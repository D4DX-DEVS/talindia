{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talindia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "talindia" }
  ],
  // DB and NEXT_TAG_CACHE_D1 share one database (created with `wrangler d1 create talindia-db`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talindia-db",
      "database_id": "ca2b3b72-4f10-4fb4-be97-0f24d468a57e",
      "migrations_dir": "drizzle/migrations"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "talindia-db",
      "database_id": "ca2b3b72-4f10-4fb4-be97-0f24d468a57e",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "talindia-media" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "talindia-next-cache" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
  "vars": {
    "SITE_URL": "https://talindia.co"
  }
}
